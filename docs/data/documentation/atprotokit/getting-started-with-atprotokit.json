h the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/authenticate(with:password:)","type":"reference"},{"text":" method:","type":"text"}]},{"type":"codeListing","code":["Task {","    try await config.authenticate(with: \"lucy.bsky.social\", password: \"hunter2\")","}"],"syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not use the password you typically use for signing into Bluesky: only use a specific App Password that’s in use for this instance of ATProtoKit only. To generate an App Password, go to the Bluesky website, then go to Settings > Privacy & Security > App Passwords and follow the instructions."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"type":"codeVoice","code":"do-catch"},{"type":"text","text":" block to create the "},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession","type":"reference"},{"type":"text","text":" object (if the session was successfully created) or handle the error (if an error occured):"}]},{"type":"codeListing","code":["let config = ATProtocolConfiguration()","","Task {","    do {","        try await config.authenticate(with: \"lucy.bsky.social\", password: \"hunter2\")","","        \/\/ Handle the success.","    } catch {","        \/\/ Handle the error.","    }","}"],"syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"If you’ve enabled Two-Factor Authentication (via email), ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/authenticate(with:password:)","isActive":true,"type":"reference"},{"text":" waits for the code after the server returns ","type":"text"},{"code":"AuthFactorTokenRequired","type":"codeVoice"},{"text":". Check your inbox for the code, then pass it to ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/receiveCodeFromUser(_:)","isActive":true,"type":"reference"},{"text":" from your UI or command-line input handler.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession"},{"type":"text","text":" will contain, among other things, the access and refresh tokens. ATProtoKit abstracts this away for you so you don’t need to add it every time you use a method that requires an active session."}]},{"type":"paragraph","inlineContent":[{"text":"You can then create an ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit","isActive":true,"type":"reference"},{"text":" instance, where you can insert the ","type":"text"},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","isActive":true},{"type":"text","text":" object in the "},{"type":"codeVoice","code":"sessionConfiguration"},{"type":"text","text":" parameter:"}]},{"type":"codeListing","syntax":"swift","code":["Task {","    let atProto = await ATProtoKit(sessionConfiguration: config)","}"]},{"type":"heading","text":"Creating a post","anchor":"Creating-a-post","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create a post, first create an "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","isActive":true},{"type":"text","text":" instance, with the "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit","isActive":true},{"type":"text","text":" instance as the parameter:"}]},{"type":"codeListing","syntax":"swift","code":["let atProtoBluesky = ATProtoBluesky(atProtoKitInstance: atProto)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/createPostRecord(text:inlineFacets:locales:replyTo:embed:labels:tags:creationDate:replyControls:embeddingRules:recordKey:shouldValidate:swapCommit:)"},{"type":"text","text":" method. While this method is extremely extensive, we’re only going to focus on the "},{"type":"codeVoice","code":"text"},{"type":"text","text":" parameter."}]},{"type":"codeListing","syntax":"swift","code":["let postResult = try await atProtoBluesky.createPostRecord(text: \"Hello Bluesky!\")","print(postResult)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should see the post in your Bluesky account once you run this code. When the method successfully completes, you’ll receive a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference"},{"type":"text","text":" object that contains the URI of the record ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference\/recordURI"},{"type":"text","text":") and the content identifier hash of the record ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference\/recordCID"},{"type":"text","text":")."}]},{"type":"heading","text":"View Your Own Posts","anchor":"View-Your-Own-Posts","level":3},{"type":"paragraph","inlineContent":[{"text":"To view your own posts, you can use ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit\/getAuthorFeed(by:limit:cursor:postFilter:shouldIncludePins:)","isActive":true,"type":"reference"},{"text":" and use ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession\/handle","isActive":true,"type":"reference"},{"text":" in the first argument:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["do {","    guard let session = try await atProto.getUserSession() else { return }","    let myFeed = try await atProto.getAuthorFeed(by: session.handle)","    print(\"Feed: \\(myFeed)\")","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"text":"By default, it will grab the first 50 posts from you, including replies, and without the pinned post. However, you can tweak that with the ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", ","type":"text"},{"code":"postFilter","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"shouldIncludePins","type":"codeVoice"},{"text":" arguments. You can also poll more posts if a singular call reaches its limit by using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon\/Feed\/GetAuthorFeedOutput\/cursor","type":"reference"},{"text":" with the next API call:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let myFeed = try await atProto.getAuthorFeed(","    by: \"lucy.bsky.social\",","    limit: 100",")","","print(\"Feed (first 100 posts): \\(myFeed)\")","","\/\/ To get the next 100 posts, call the method again,","\/\/ but attach the `cursor` as an argument.","","let myFeedExtended = try await atProto.getAuthorFeed(","    by: \"lucy.bsky.social\",","    limit: 100,","    cursor: myFeed.cursor",")","","print(\"Feed (next 100 posts): \\(myFeedExtended)\")"]}]}],"references":{"doc://ATProtoKit/documentation/ATProtoKit/ComAtprotoLexicon/Repository/StrongReference":{"role":"symbol","title":"ComAtprotoLexicon.Repository.StrongReference","url":"\/documentation\/atprotokit\/comatprotolexicon\/repository\/strongreference","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StrongReference"}],"navigatorTitle":[{"kind":"identifier","text":"StrongReference"}],"kind":"symbol","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongRefer