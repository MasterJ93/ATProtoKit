{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"ATProtoKit is designed to make it easy for you to interact with the AT Protocol and other services built on of the technology, such as Bluesky.","type":"text"}]},{"anchor":"Creating-a-session","type":"heading","level":3,"text":"Creating a session"},{"type":"paragraph","inlineContent":[{"text":"In order to log in, you need to create a session. To get started, create a new ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","type":"reference","isActive":true},{"type":"text","text":" instance:"}]},{"syntax":"swift","type":"codeListing","code":["let config = ATProtocolConfiguration()"]},{"type":"paragraph","inlineContent":[{"text":"Then, you can create a session with the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/authenticate(with:password:)"},{"type":"text","text":" method:"}]},{"type":"codeListing","code":["Task {","    try await config.authenticate(with: \"lucy.bsky.social\", password: \"hunter2\")","}"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":"Do not use the password you typically use for signing into Bluesky: only use a specific App Password that’s in use for this instance of ATProtoKit only. To generate an App Password, go to the Bluesky website, then go to Settings > Privacy & Security > App Passwords and follow the instructions."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"inlineContent":[{"text":"You can use a ","type":"text"},{"type":"codeVoice","code":"do-catch"},{"type":"text","text":" block to create the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession"},{"type":"text","text":" object (if the session was successfully created) or handle the error (if an error occured):"}],"type":"paragraph"},{"code":["let config = ATProtocolConfiguration()","","Task {","    do {","        try await config.authenticate(with: \"lucy.bsky.social\", password: \"hunter2\")","","        \/\/ Handle the success.","    } catch {","        \/\/ Handle the error.","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’ve enabled Two-Factor Authentication (via email), "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/authenticate(with:password:)","type":"reference","isActive":true},{"type":"text","text":" waits for the code after the server returns "},{"type":"codeVoice","code":"AuthFactorTokenRequired"},{"type":"text","text":". Check your inbox for the code, then pass it to "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/receiveCodeFromUser(_:)","isActive":true},{"type":"text","text":" from your UI or command-line input handler."}]}],"type":"aside"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession","isActive":true},{"type":"text","text":" will contain, among other things, the access and refresh tokens. ATProtoKit abstracts this away for you so you don’t need to add it every time you use a method that requires an active session."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can then create an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit"},{"type":"text","text":" instance, where you can insert the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration"},{"type":"text","text":" object in the "},{"type":"codeVoice","code":"sessionConfiguration"},{"type":"text","text":" parameter:"}],"type":"paragraph"},{"code":["Task {","    let atProto = await ATProtoKit(sessionConfiguration: config)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Creating-a-post","type":"heading","text":"Creating a post"},{"inlineContent":[{"type":"text","text":"To create a post, first create an "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","type":"reference","isActive":true},{"type":"text","text":" instance, with the "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit","type":"reference","isActive":true},{"type":"text","text":" instance as the parameter:"}],"type":"paragraph"},{"code":["let atProtoBluesky = ATProtoBluesky(atProtoKitInstance: atProto)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Then use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/createPostRecord(text:inlineFacets:locales:replyTo:embed:labels:tags:creationDate:replyControls:embeddingRules:recordKey:shouldValidate:swapCommit:)"},{"type":"text","text":" method. While this method is extremely extensive, we’re only going to focus on the "},{"type":"codeVoice","code":"text"},{"type":"text","text":" parameter."}],"type":"paragraph"},{"syntax":"swift","code":["let postResult = try await atProtoBluesky.createPostRecord(text: \"Hello Bluesky!\")","print(postResult)"],"type":"codeListing"},{"inlineContent":[{"text":"You should see the post in your Bluesky account once you run this code. When the method successfully completes, you’ll receive a ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference","isActive":true,"type":"reference"},{"type":"text","text":" object that contains the URI of the record ("},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference\/recordURI","type":"reference","isActive":true},{"type":"text","text":") and the content identifier hash of the record ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference\/recordCID"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"View Your Own Posts","level":3,"anchor":"View-Your-Own-Posts","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"To view your own posts, you can use ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit\/getAuthorFeed(by:limit:cursor:postFilter:shouldIncludePins:)","isActive":true,"type":"reference"},{"type":"text","text":" and use "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession\/handle","isActive":true,"type":"reference"},{"type":"text","text":" in the first argument:"}]},{"syntax":"swift","type":"codeListing","code":["do {","    guard let session = try await atProto.getUserSession() else { return }","    let myFeed = try await atProto.getAuthorFeed(by: session.handle)","    print(\"Feed: \\(myFeed)\")","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"text":"By default, it will grab the first 50 posts from you, including replies, and without the pinned post. However, you can tweak that with the ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", ","type":"text"},{"code":"postFilter","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"shouldIncludePins","type":"codeVoice"},{"text":" arguments. You can also poll more posts if a singular call reaches its limit by using ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon\/Feed\/GetAuthorFeedOutput\/cursor"},{"text":" with the next API call:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let myFeed = try await atProto.getAuthorFeed(","    by: \"lucy.bsky.social\",","    limit: 100",")","","print(\"Feed (first 100 posts): \\(myFeed)\")","","\/\/ To get the next 100 posts, call the method again,","\/\/ but attach the `cursor` as an argument.","","let myFeedExtended = try await atProto.getAuthorFeed(","    by: \"lucy.bsky.social\",","    limit: 100,","    cursor: myFeed.cursor",")","","print(\"Feed (next 100 posts): \\(myFeedExtended)\")"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Getting-Started-with-ATProtoKit"},"hierarchy":{"paths":[["doc:\/\/ATProtoKit\/documentation\/ATProtoKit"]]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Sign in with a Bluesky account, send a post, and view the account’s posts."}],"variants":[{"paths":["\/documentation\/atprotokit\/getting-started-with-atprotokit"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"color":{"standardColorIdentifier":"blue"},"images":[{"identifier":"bluesky_logo.png","type":"icon"}],"roleHeading":"Article","role":"article","title":"Getting Started with ATProtoKit","modules":[{"name":"ATProtoKit"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoAdmin","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBlueskyChat"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"references":{"doc://ATProtoKit/documentation/ATProtoKit/ATProtoKit":{"title":"ATProtoKit","type":"topic","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit","url":"\/documentation\/atprotokit\/atprotokit","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATProtoKit"}],"navigatorTitle":[{"kind":"identifier","text":"ATProtoKit"}],"role":"symbol","abstract":[{"type":"text","text":"The base class that handles the main functionality of the "},{"code":"ATProtoKit","type":"codeVoice"},{"text":" API library.",