c:\/\/ATProtoKit\/s16SendableMetatypeP"],"kind":"relationships"},{"title":"Conforming Types","type":"conformingTypes","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppleSecureKeychain"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/atprotokit\/atcredentialstore"]}],"abstract":[{"text":"A low-level protocol for storing opaque credential data in a secure, persistent backend.","type":"text"}],"metadata":{"symbolKind":"protocol","roleHeading":"Protocol","modules":[{"name":"ATProtoKit"}],"remoteSource":{"fileName":"ATCredentialStore.swift","url":"https:\/\/github.com\/MasterJ93\/ATProtoKit\/tree\/main\/Sources\/ATProtoKit\/APIReference\/SessionManager\/ATCredentialStore.swift#L79"},"title":"ATCredentialStore","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ATCredentialStore"}],"externalID":"s:10ATProtoKit17ATCredentialStoreP","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATCredentialStore"}]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATCredentialStore"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}],"kind":"declarations"},{"mentions":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CredentialStorageMigration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfigurationArticle","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthIntegration"],"kind":"mentions"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the common storage boundary for both App Password and OAuth sessions. ATProtoKit uses"},{"type":"text","text":" "},{"type":"text","text":"it to persist the App Password and refresh token, while keeping the short-lived access token"},{"type":"text","text":" "},{"type":"text","text":"in-memory (via "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","isActive":true},{"type":"text","text":"). An application can use the same store for an OAuth"},{"type":"text","text":" "},{"type":"text","text":"sessionby encoding the OAuth library’s complete restorable session and assigning it a"},{"type":"text","text":" "},{"type":"text","text":"separate key."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol deliberately does not define token types, lifecycle behaviors, or a session"},{"type":"text","text":" "},{"type":"text","text":"identifier. Callers own their value format and key namespace, while the conforming store owns"},{"type":"text","text":" "},{"type":"text","text":"secure persistence."}]},{"level":2,"text":"Conforming types","type":"heading","anchor":"Conforming-types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"ATProtoKit includes one public conforming type: "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppleSecureKeychain","isActive":true},{"type":"text","text":". It stores each value"},{"type":"text","text":" "},{"type":"text","text":"as a generic-password item in Apple Keychain and is available on iOS, iPadOS, macOS, tvOS,"},{"type":"text","text":" "},{"type":"text","text":"visionOS, and watchOS. "},{"type":"codeVoice","code":"ATProtocolConfiguration"},{"type":"text","text":" consumes a store but does not itself conform"},{"type":"text","text":" "},{"type":"text","text":"to this protocol."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ATProtoKit does not include a Linux or Windows backend because the application must"},{"type":"text","text":" "},{"type":"text","text":"choose the protected credential service appropriate to its deployment environment."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom backend implements only the three opaque-data operations. It does not need separate"},{"type":"text","text":" "},{"type":"text","text":"App Password methods, access token caching, or OAuth token knowledge:"}]},{"syntax":"swift","code":["public actor ApplicationCredentialStore: ATCredentialStore {","    private let protectedVault: ApplicationProtectedVault","","    public init(protectedVault: ApplicationProtectedVault) {","        self.protectedVault = protectedVault","    }","","    public func loadValue(forKey key: String) async throws -> Data? {","        return try await protectedVault.loadValue(forKey: key)","    }","","    public func saveValue(_ value: Data, forKey key: String) async throws {","        try await protectedVault.saveValue(value, forKey: key)","    }","","    public func deleteValue(forKey key: String) async throws {","        try await protectedVault.deleteValue(forKey: key)","    }","}"],"type":"codeListing"},{"syntax":"swift","code":["let store = AppleSecureKeychain(serviceName: \"com.example.application.credentials\")","let sessionData = try JSONEncoder().encode(oauthSession)","","try await store.saveValue(sessionData, forKey: \"oauth.current-session\")","","if let restoredData = try await store.loadValue(forKey: \"oauth.current-session\") {","    let restoredSession = try JSONDecoder().decode(","        OAuthSession.self,","        from: restoredData","    )","    \/\/ Revalidate the restored session before using it.","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use a custom store for an App Password session, pass it directly to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","code":["let configuration = ATProtocolConfiguration(","    credentialStore: applicationCredentialStore,","    sessionIdentifier: persistedAccountIdentifier",")"],"type":"codeListing"}],"kind":"content"}],"sections":[],"references":{"doc://ATProtoKit/documentation/ATProtoKit/ATAccountCreating":{"role":"symbol","title":"ATAccountCreating","url":"\/documentation\/atprotokit\/ataccountcreating","navigatorTitle":[{"kind":"identifier","text":"ATAccountCreating"}],"kind":"symbol","abstract":[{"type":"text","text":"Creates AT Protocol accounts through a session configuration."}],"type":"topic","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATAccountCreating","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATAccountCreating"}]},"doc://ATProtoKit/documentation/ATProtoKit/ATProtoKitConfiguration":{"type":"topic","title":"ATProtoKitConfiguration","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKitConfiguration","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATProtoKitConfiguration"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ATProtoKitConfiguration"}],"abstract":[{"text":"Defines a protocol for configurations in the ","type":"text"},{"type":"codeVoice","code":"ATProtoKit"},{"text":" API library.","type":"text"}],"role":"symbol","url":"\/documentation\/atprotokit\/atprotokitconfiguration"},"doc://ATProtoKit/documentation/ATProtoKit/SessionAuthorization":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionAuthorization"}],"url":"\/documentation\/atprotokit\/sessionauthorization","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Describes an authorization value and related headers for an AT Protocol request."}],"navigatorTitle":[{"kind":"identifier","text":"SessionAuthorization"}],"title":"SessionAuthorization","type":"topic","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorization"},"doc://ATProtoKit/documentation/ATPr