":"text","text":"s."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"To create a record, you’ll need to make a "},{"type":"codeVoice","code":"public"},{"type":"text","text":" "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" that conforms to this "},{"type":"codeVoice","code":"protocol"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"The ","type":"text"},{"code":"type","type":"codeVoice"},{"text":" property must be ","type":"text"},{"type":"codeVoice","code":"public"},{"type":"text","text":" and "},{"type":"codeVoice","code":"static"},{"type":"text","text":" due to the "},{"type":"codeVoice","code":"protocol"},{"type":"text","text":", but it shouldn’t"},{"type":"text","text":" "},{"type":"text","text":"be changed for the entire lifetime of the "},{"type":"codeVoice","code":"struct"},{"type":"text","text":". One way to solve this is to use a"},{"type":"text","text":" "},{"type":"codeVoice","code":"private(set)"},{"type":"text","text":" keyword:"}],"type":"paragraph"},{"syntax":"swift","code":["public struct UserProfile: ATRecordProtocol {","    public static private(set) var type = \"com.example.actor.profile\" \/\/ `private(set)` used here.","    public let userID: Int","    public let username: String","    public var bio: String?","    public var avatarURL: URL?","    public var followerCount: Int?","    public var followingCount: Int?","}"],"type":"codeListing"},{"inlineContent":[{"text":"You must create a ","type":"text"},{"code":"CodingKeys","type":"codeVoice"},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" that is of types ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"CodingKey"},{"type":"text","text":". This is"},{"type":"text","text":" "},{"type":"text","text":"because the "},{"type":"codeVoice","code":"type"},{"type":"text","text":" property needs to map to the "},{"type":"code