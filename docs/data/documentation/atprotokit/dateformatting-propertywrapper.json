{"variants":[{"paths":["\/documentation\/atprotokit\/dateformatting-propertywrapper"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/ATProtoKit\/documentation\/ATProtoKit"]]},"identifier":{"url":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/DateFormatting-PropertyWrapper","interfaceLanguage":"swift"},"sections":[],"metadata":{"color":{"standardColorIdentifier":"blue"},"role":"collectionGroup","title":"Custom Date Encoding and Decoding","roleHeading":"API Collection","modules":[{"name":"ATProtoKit"}]},"kind":"article","abstract":[{"text":"Convert dates to and from the ISO8601 format.","type":"text"}],"topicSections":[{"anchor":"CustomDateFormatter","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CustomDateFormatter"],"title":"CustomDateFormatter"},{"anchor":"Decodable-Methods","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedDecodingContainer\/decodeDate(forKey:)","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedDecodingContainer\/decodeDateIfPresent(forKey:)"],"title":"Decodable Methods"},{"anchor":"Encodable-Methods","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedEncodingContainer\/encodeDate(_:forKey:)","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedEncodingContainer\/encodeDateIfPresent(_:forKey:)"],"title":"Encodable Methods"}],"seeAlsoSections":[{"generated":true,"anchor":"Utilities","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATIdentityProtocol","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoTools","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATFacetParser","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionToken","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATRecordDecoder","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATBuiltInIdentityResolver","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AttachmentLexiconLimit","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Truncatable","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/APIHostname"],"title":"Utilities"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AT Protocol requires that dates must be formatted in the ISO8601 format. ATProtoKit gives you the tools to convert from "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" to ISO8601 formatted dates and vice versa with custom "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Encodable"},{"type":"text","text":" methods. All methods use "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CustomDateFormatter","isActive":true},{"type":"text","text":" to do the decoding and encoding."}]},{"level":2,"text":"Usage","type":"heading","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you rather write the custom initializers and methods manually, you can do so as well. When creating the custom initializers and methods, you’ll want to replace the following methods with the custom ones:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"With…"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"decode(_:forKey:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedDecodingContainer\/decodeDate(forKey:)","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"decodeIfPresent(_:forKey:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedDecodingContainer\/decodeDateIfPresent(forKey:)","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encode(_:forKey:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedEncodingContainer\/encodeDate(_:forKey:)","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"encodeIfPresent(_:forKey:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Swift\/KeyedEncodingContainer\/encodeDateIfPresent(_:forKey:)","isActive":true}]}]]],"type":"table","alignments":["right","left"],"header":"row"},{"type":"codeListing","syntax":"swift","code":["public struct UserProfile: ATRecordProtocol {","    public static private(set) var type = \"com.example.actor.profile\"","    public let userID: Int","    public let username: String","    public var bio: String?","    public var avatarURL: URL?","    public var followerCount: Int?","    public var followingCount: Int?","    public let createdAt: Date","","    public init(userID: Int, username: String, bio: String? = nil, avatarURL: URL? = nil,","                followerCount: Int? = nil, followingCount: Int? = nil, createdAt: Date) {","        self.userID = userID","        self.username = username","        self.bio = bio","        self.avatarURL = avatarURL","        self.followerCount = followerCount","        self.followingCount = followingCount","        self.createdAt = createdAt","    }","","    public init(from decoder: any Decoder) throws {","        let container = try decoder.container(keyedBy: CodingKeys.self)","","        self.userID = try container.decode(Int.self, forKey: .userID)","        self.username = try container.decode(String.self, forKey: .username)","        self.bio = try container.decodeIfPresent(String.self, forKey: .bio)","        self.avatarURL = try container.decodeIfPresent(URL.self, forKey: .avatarURL)","        self.followerCount = try container.decodeIfPresent(Int.self, forKey: .followerCount)","        self.followingCount = try container.decodeIfPresent(Int.self, forKey: .followingCount)","        \/\/ Replace `container.decode(Date.self, forKey: .createAt)`.","        self.createdAt = try container.decodeDate(forKey: .createdAt)","    }","","    public func encode(to encoder: any Encoder) throws {","        var container = encoder.container(keyedBy: CodingKeys.self)","","        try container.encode(self.userID, forKey: .userID)","        try container.encode(self.username, forKey: .username)","        try container.encodeIfPresent(self.bio, forKey: .bio)","        try container.encodeIfPresent(self.avatarURL, forKey: .avatarURL)","        try container.encodeIfPresent(self.followerCount, forKey: .followerCount)","        try container.encodeIfPresent(self.followingCount, forKey: .followingCount)","        \/\/ Replace `container.encode(self.createdAt, forKey: .createdAt)`.","        try container.encodeDate(self.createdAt, forKey: .createdAt)","    }","","    enum CodingKeys: String, CodingKey {","        case userID = \"user_id\"","        case username","        case bio","        case avatarURL = \"avatar_url\"","        case followerCount = \"follower_count\"","        case followingCount = \"following_count\"","        case createdAt = \"created_at\"","    }","}"]}],"kind":"content"}],"references":{"atprotokit_icon.png":{"type":"image","identifier":"atprotokit_icon.png","alt":"A technology icon representing the ATProtoKit framework.","variants":[{"traits":["1x","light"],"url":"\/images\/ATProtoKit\/atprotokit_icon.png"}]},"doc://ATProtoKit/documentation/ATProtoKit/ATBuiltInIdentityResolver":{"title":"ATBuiltInIdentityResolver","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"ATBuiltInIdentityResolver","kind":"identifier"}],"url":"\/documentation\/atprotokit\/atbuiltinidentityresolver","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATBuiltInIdentityResolver","abstract":[{"text":"A lightweight, dependency-fr