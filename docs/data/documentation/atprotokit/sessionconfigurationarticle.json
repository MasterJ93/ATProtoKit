{"abstract":[{"type":"text","text":"Choose a built-in authentication configuration or implement ATProtoKit’s request-time session contract."}],"metadata":{"modules":[{"name":"ATProtoKit"}],"role":"article","color":{"standardColorIdentifier":"blue"},"roleHeading":"Article","title":"Configuring and Implementing Sessions"},"seeAlsoSections":[{"generated":true,"title":"Authentication and Session Management","anchor":"Authentication-and-Session-Management","identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CredentialStorageMigration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKitConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorization","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordAuthenticating","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATAccountCreating","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordCredentialStoring","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordSessionManaging","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthIntegration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthWalkthrough","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthSessionSynchronizing","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ClosureATRequestExecutor"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration","isActive":true},{"type":"text","text":" is the common request-time contract used by ATProtoKit. It identifies a session, configures networking, exposes the current account context, and authorizes requests. It does not require every conforming type to implement account creation, token refresh, credential storage, or session deletion."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Those lifecycle operations are separated into capability protocols for App Password and OAuth sessions. Most applications should construct "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true,"type":"reference"},{"text":" instead of implementing the protocols directly.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Choose-the-appropriate-configuration","text":"Choose the appropriate configuration"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","isActive":true,"type":"reference"},{"text":" for App Password authentication. It provides the complete built-in App Password lifecycle:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"authenticating with a handle and App Password;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"accepting multi-factor authentication codes;","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"keeping the short-lived access token in configuration memory;","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"persisting the App Password and rotating refresh token through ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATCredentialStore","isActive":true,"type":"reference"},{"text":";","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"refreshing authorization before authenticated requests;","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"registering the public ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession","isActive":true,"type":"reference"},{"text":" context; and","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"deleting the remote session and locally stored credentials.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true},{"type":"text","text":" when an external OAuth package owns authorization. ATProtoKit does not implement identity verification, authorization-server discovery, PAR, PKCE, DPoP, OAuth token persistence, refresh, or nonce retries. The OAuth package supplies the visible account context and executes complete requests through an "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATRequestExecutor","isActive":true},{"type":"text","text":". See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthIntegration"},{"text":" for that integration pattern.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"OAuth permission scopes are also selected in the external OAuth package’s authorization request, not on ","type":"text"},{"code":"SessionConfiguration","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ATOAuthSessionConfiguration","type":"codeVoice"},{"text":". The resulting ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext","type":"reference"},{"text":" records the exact scopes returned by the authorization server; it does not request or expand them. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthIntegration","type":"reference"},{"text":" for requesting additional scopes and upgrading an existing session.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Understand-the-core-contract","text":"Understand the core contract","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration","isActive":true,"type":"reference"},{"text":" inherits from ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATRequestAuthenticator","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"code":"AnyObject","type":"codeVoice"},{"text":". Consequently, a conformer must be a concurrency-safe reference type, but the protocol does not specifically require a ","type":"text"},{"code":"final","type":"codeVoice"},{"text":" ","type":"text"},{"code":"class","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"final","type":"codeVoice"},{"text":" ","type":"text"},{"code":"class","type":"codeVoice"},{"text":" with immutable sendable state or an actor are common implementation choices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol requires:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pdsURL"},{"text":", the bootstrap Personal Data Server (PDS) URL;","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"configuration"},{"type":"text","text":", the "},{"type":"codeVoice","code":"URLSessionConfiguration"},{"type":"text","text":" used by ATProtoKit;"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"instanceUUID"},{"text":", the identifier used with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistry","type":"reference"},{"text":"; and","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/authorization(for:)","type":"reference","isActive":true},{"type":"text","text":", which supplies header-based authorization."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"It also offers these request-time extension points:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/requestExecutor","isActive":true,"type":"reference"},{"text":" defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":";","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/requestExecutorOwnsAuthorization","isActive":true,"type":"reference"},{"text":" defaults to ","type":"text"},{"code":"false","type":"codeVoice"},{"text":";","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATRequestAuthenticator\/authenticatedRequest(for:authorizationRequirement:)","isActive":true,"type":"reference"},{"text":" applies the value","type":"text"},{"text":" ","type":"text"},{"text":"returned by ","type":"text"},{"code":"authorization(for:)","type":"codeVoice"},{"text":" only to requests marked as requiring a session; and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/authorizationContext()","isActive":true,"type":"reference"},{"text":" defaults to deriving a context from the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession","isActive":true,"type":"reference"},{"text":" registered under ","type":"text"},{"code":"instanceUUID","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"pdsURL","type":"codeVoice"},{"text":" property is a bootstrap value and does not change when a session is registered. Code that constructs an ATProtoKit client manually after loading a dynamic context must pass the registered context’s ","type":"text"},{"code":"serviceEndpoint","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit\/createOAuthSession(sessionConfiguration:apiClientConfiguration:atidentityResolver:canUseBlueskyRecords:)","type":"reference"},{"text":" does this automatically for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Add-lifecycle-capabilities-deliberately","text":"Add lifecycle capabilities deliberately","level":2},{"type":"paragraph","inlineContent":[{"text":"Conform to focused capability protocols only when the custom type owns their behavior:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistryManaging","type":"reference","isActive":true},{"type":"text","text":" adds session registration and removal;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordCredentialStoring","type":"reference","isActive":true},{"type":"text","text":" adds an "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATCredentialStore","type":"reference","isActive":true},{"type":"text","text":" for the App Password and refresh"},{"type":"text","text":" "},{"type":"text","text":"token, including explicit refresh-token inspection;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordAuthenticating","type":"reference","isActive":true},{"type":"text","text":" adds App Password authentication, in-memory access-token caching,"},{"type":"text","text":" "},{"type":"text","text":"refresh, request-time validation, and authentication-factor input;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATAccountCreating","type":"reference","isActive":true},{"type":"text","text":" adds account creation;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordSessionManaging","type":"reference","isActive":true},{"type":"text","text":" combines all built-in App Password lifecycle capabilities; and"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthSessionSynchronizing","type":"reference","isActive":true},{"type":"text","text":" reloads context owned by an external OAuth implementation."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The default implementations for App Password authentication and lifecycle operations are defined on these App Password capability protocols, not on ","type":"text"},{"type":"codeVoice","code":"SessionConfiguration"},{"text":" itself. A custom ","type":"text"},{"type":"codeVoice","code":"SessionConfiguration"},{"text":" does not acquire those operations automatically.","type":"text"}]},{"type":"heading","anchor":"Configure-App-Password-persistence","text":"Configure App Password persistence","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATCredentialStore","type":"reference"},{"text":" is an opaque, persistent data store. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","type":"reference"},{"text":" writes only the App Password and refresh token to it. The access token is intentionally held by the configuration’s actor-backed memory cache and is replaced whenever the session refreshes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On Apple platforms, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppleSecureKeychain","type":"reference"},{"text":" is the default store. To restore an App Password session in a later process, persist the configuration’s session identifier with the application’s account metadata, recreate the configuration with that identifier, and call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistryManaging\/registerSession()","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let secureStore = AppleSecureKeychain(","    serviceName: \"com.example.app.credentials\"",")","let configuration = ATProtocolConfiguration(","    credentialStore: secureStore,","    sessionIdentifier: persistedAccountIdentifier",")","","try await configuration.registerSession()","let client = await ATProtoKit(","    sessionConfiguration: configuration,","    pdsURL: configuration.pdsURL",")"]},{"type":"paragraph","inlineContent":[{"text":"The recreated configuration starts without an access token. Registration refreshes from the persisted refresh token, caches the new access token, loads the server’s current session, and registers its public context. If no refresh token exists, or the session can no longer be refreshed, the application must authenticate again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use a different stable identifier for each App Password account. ATProtoKit builds its internal keys from that identifier, so changing it makes the previously stored credentials inaccessible to the new configuration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Applications can supply a custom backend through the same initializer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let configuration = ATProtocolConfiguration(","    credentialStore: customCredentialStore,","    sessionIdentifier: persistedAccountIdentifier",")"]},{"type":"paragraph","inlineContent":[{"text":"Linux and Windows applications must currently provide their own ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATCredentialStore","type":"reference"},{"text":". An OAuth persistence adapter may also choose to use the same backend under separate app-owned keys, but ATProtoKit does not automatically store OAuth sessions in ","type":"text"},{"type":"codeVoice","code":"ATCredentialStore"},{"text":". See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CredentialStorageMigration","type":"reference"},{"text":" for storage compatibility and migration details.","type":"text"}]},{"type":"heading","anchor":"Select-a-PDS-before-App-Password-authentication","text":"Select a PDS before App Password authentication","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","type":"reference"},{"text":" sends App Password authentication to its configured ","type":"text"},{"type":"codeVoice","code":"pdsURL"},{"text":", which defaults to ","type":"text"},{"type":"codeVoice","code":"https:\/\/bsky.social"},{"text":". If the application verifies a handle and discovers another PDS before authentication, construct the configuration with that origin:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let verifiedIdentity = try await identityResolver.resolveVerifiedIdentity(","    handle: enteredHandle",")","let configuration = ATProtocolConfiguration(","    pdsURL: verifiedIdentity.pdsURL.absoluteString,","    credentialStore: secureStore,","    sessionIdentifier: persistedAccountIdentifier",")","","try await configuration.authenticate(","    with: verifiedIdentity.handle,","    password: appPassword",")","let client = await ATProtoKit(","    sessionConfiguration: configuration,","    pdsURL: configuration.pdsURL",")"]},{"type":"paragraph","inlineContent":[{"text":"The identity resolver and its method names in this example represent an application-selected identity package. The application remains responsible for verifying that the handle, DID, and PDS relationship is trustworthy before sending credentials to the discovered service.","type":"text"}]},{"type":"heading","anchor":"Implement-header-based-authorization","text":"Implement header-based authorization","level":2},{"type":"paragraph","inlineContent":[{"text":"A custom configuration is appropriate for an authentication mechanism that can authorize the final request with headers and does not require OAuth’s DPoP nonce and retry ownership. The configuration returns a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorization","type":"reference"},{"text":" value; ATProtoKit applies it only when the method marks the request as requiring a session.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public actor ApplicationTokenStore {","","    private var token: String","","    public init(token: String) {","        self.token = token","    }","","    public func currentToken() -> String {","        return token","    }","}","","public final class ApplicationSessionConfiguration: SessionConfiguration {","","    public let pdsURL: String","","    public let configuration: URLSessionConfiguration","","    public let instanceUUID: UUID","","    private let tokenStore: ApplicationTokenStore","","    public init(","        pdsURL: String,","        instanceUUID: UUID,","        tokenStore: ApplicationTokenStore","    ) {","        self.pdsURL = pdsURL","        self.configuration = .default","        self.instanceUUID = instanceUUID","        self.tokenStore = tokenStore","    }","","    public func authorization(","        for request: URLRequest","    ) async throws -> SessionAuthorization? {","        return .bearer(await tokenStore.currentToken())","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Register the corresponding ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSession","type":"reference"},{"text":" under the same ","type":"text"},{"type":"codeVoice","code":"instanceUUID"},{"text":" before calling APIs that need the active account’s DID or service endpoint. Alternatively, conform the custom configuration to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistryManaging","type":"reference"},{"text":" and implement that lifecycle within the type.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Do not use this header-only pattern for OAuth. OAuth request execution must remain with the OAuth package so it can create a DPoP proof for the final method and URL, respond to nonce challenges, rotate tokens, and retry safely.","type":"text"}]}],"name":"Note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/atprotokit\/sessionconfigurationarticle"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfigurationArticle"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/ATProtoKit\/documentation\/ATProtoKit"]]},"references":{"doc://ATProtoKit/documentation/ATProtoKit/ATProtoKit/createOAuthSession(sessionConfiguration:apiClientConfiguration:atidentityResolver:canUseBlueskyRecords:)":{"kind":"symbol","abstract":[{"text":"Creates an authenticated ATProtoKit client after registering an external OAuth session.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"createOAuthSession"},