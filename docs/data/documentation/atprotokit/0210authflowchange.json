tor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppleSecureKeychain"}],"abstract":[{"text":"Manages the keychains asociated with the sessions for the AT Protocol.","type":"text"}],"url":"\/documentation\/atprotokit\/applesecurekeychain","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppleSecureKeychain"},"doc://ATProtoKit/documentation/ATProtoKit/ATProtocolConfiguration/authenticate(with:password:)":{"kind":"symbol","role":"symbol","type":"topic","title":"authenticate(with:password:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"password"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[],"url":"\/documentation\/atprotokit\/atprotocolconfiguration\/authenticate(with:password:)","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/authenticate(with:password:)"},"doc://ATProtoKit/documentation/ATProtoKit/SessionConfiguration/codeStream":{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/codeStream","title":"codeStream","abstract":[{"text":"The async stream that receives user-provided authentication codes.","type":"text"}],"type":"topic","required":true,"role":"symbol","url":"\/documentation\/atprotokit\/sessionconfiguration\/codestream","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"codeStream"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">"}],"kind":"symbol"},"doc://ATProtoKit/documentation/ATProtoKit/SessionConfiguration/codeContinuation":{"url":"\/documentation\/atprotokit\/sessionconfiguration\/codecontinuation","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"The continuation used to yield new user input into the "},{"code":"codeStream","type":"codeVoice"},{"type":"text","text":"."}],"title":"codeContinuation","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration\/codeContinuation","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"codeContinuation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"}],"required":true},"doc://ATProtoKit/documentation/ATProtoKit/ATProtocolConfiguration/deleteSession()":{"role":"symbol","url":"\/documentation\/atprotokit\/atprotocolconfiguration\/deletesession()","kind":"symbol","title":"deleteSession()","abstract":[],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration\/deleteSession()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"deleteSession"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}]},"doc://ATProtoKit/documentation/ATProtoKit/ATProtocolConfiguration/refreshSession()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"refreshSession"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[],"role":"symbol","ki