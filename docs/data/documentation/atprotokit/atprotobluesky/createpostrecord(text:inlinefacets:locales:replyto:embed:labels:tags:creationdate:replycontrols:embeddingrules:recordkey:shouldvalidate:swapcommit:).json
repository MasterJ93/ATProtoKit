:10ATProtoKit17ComAtprotoLexiconO"},{"text":".","kind":"text"},{"text":"Repository","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository","kind":"typeIdentifier","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO10RepositoryO"},{"text":".","kind":"text"},{"text":"StrongReference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference","kind":"typeIdentifier","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO10RepositoryO15StrongReferenceV"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"text","content":[{"inlineContent":[{"text":"The text that’s directly displayed in the post record. Current limit is","type":"text"},{"text":" ","type":"text"},{"text":"300 characters.","type":"text"}],"type":"paragraph"}]},{"name":"inlineFacets","content":[{"type":"paragraph","inlineContent":[{"text":"An array of URLs and index range numbers representing inline link facets.","type":"text"},{"text":" ","type":"text"},{"text":"Optional. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The languages the text is written in. Defaults to an empty array.","type":"text"},{"text":" ","type":"text"},{"text":"Current limit is 3 languages.","type":"text"}]}],"name":"locales"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The post record that this record is replying to. Optional. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"replyTo"},{"content":[{"inlineContent":[{"text":"The embed container attached to the post record. Current items include","type":"text"},{"text":" ","type":"text"},{"text":"images, videos, external links, records, and post records with media. Optional.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"embed"},{"name":"labels","content":[{"type":"paragraph","inlineContent":[{"text":"An array of labels made by the user. Optional. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An array of tags for the post record. Optional. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"tags"},{"name":"creationDate","content":[{"type":"paragraph","inlineContent":[{"text":"The date of the post record. Defaults to ","type":"text"},{"code":"Date.now","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An array of rules to control who can reply to the post. Optional.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". When provided, a threadgate record is created for the post.","type":"text"}]}],"name":"replyControls"},{"name":"embeddingRules","content":[{"type":"paragraph","inlineContent":[{"text":"An array of rules to control embedding of the post. Optional.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". When provided, a postgate record is created for the post.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The record key of the collection. Optional. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"recordKey"},{"name":"shouldValidate","content":[{"type":"paragraph","inlineContent":[{"text":"Indicates whether the record should be validated. Optional.","type":"text"},{"text":" ","type":"text"},{"text":"Defaults to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swaps out an operation based on the CID. Optional. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}],"name":"swapCommit"}]},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A strong reference, which contains the newly-created record’s URI and CID hash."}]}],"kind":"content"},{"kind":"mentions","mentions":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATLinkBuilderProtocol","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Getting-Started-with-ATProtoKit"]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This can be used instead of creating your own method if you wish not to do so."}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Postgate and threadgate records are currently created after the post. If postgate or","type":"text"},{"text":" ","type":"text"},{"text":"threadgate creation fails, the post may already exist; the thrown error does not indicate that the post","type":"text"},{"text":" ","type":"text"},{"text":"was rolled back.","type":"text"}]}]},{"text":"Creating a Post","level":1,"anchor":"Creating-a-Post","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After you authenticate into Bluesky, you can create a post by using the "},{"type":"codeVoice","code":"text"},{"type":"text","text":" argument:"}]},{"type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Just tried out the new coffee shop in town ☕️ — highly recommend the cold brew!\"","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your post is longer than 300 characters, the method will only take the first 300"},{"type":"text","text":" "},{"type":"text","text":"characters, discarding the rest."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bluesky will automatically set the language of the post to English, but if you need to"},{"type":"text","text":" "},{"type":"text","text":"manually set it, you can use the "},{"type":"codeVoice","code":"locales"},{"type":"text","text":" argument:"}]},{"type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Première promenade d'automne 🍂. Les couleurs sont magnifiques cette année!\",","        locales: [Locale(identifier: \"fr_FR\")]","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add up to three locales at once; only the first three items will be added as this"},{"type":"text","text":" "},{"type":"text","text":"is the limit mandated by Bluesky."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"createPostRecord()"},{"type":"text","text":" will automatically look for URLs, hashtags, and @mentions for you."},{"type":"text","text":" "},{"type":"text","text":"However, if you would like to add inline link facets to your account, you can use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"inlineFacets"},{"type":"text","text":" parameter:"}]},{"type":"codeListing","code":["do {","    let inlineFacet = (URL(string: \"https:\/\/www.loc.gov\/resource\/pga.05046\/\"), 57, 72)","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Where's that weird photo of a cat when you need one?\\n\\nAh: here it is!\",","        inlineFacets: [inlineFacet]","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"startPostion","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"endPostion","type":"codeVoice"},{"text":" must be UTF-8 values.","type":"text"}]}]},{"text":"Adding Embedded Content","level":1,"anchor":"Adding-Embedded-Content","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can embed various kinds of content in your post, from media to external links,"},{"type":"text","text":" "},{"type":"text","text":"to other records."}]},{"anchor":"Images","type":"heading","level":2,"text":"Images"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoTools\/ImageQuery","type":"reference","isActive":true},{"type":"text","text":" to add details to the image, such as"},{"type":"text","text":" "},{"type":"text","text":"alt text, then attach it to the post record."}]},{"type":"codeListing","code":["do {","    let image = ATProtoTools.ImageQuery(","        imageData: Data(contentsOf: \"\/path\/to\/file\/cat.jpg\"),","        fileName: \"cat.jpg\",","        altText: \"A cat looking annoyed, wearing a hat.\"","    )","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"I don't think my cat likes her new hat... 🙃\",","        embed: .images(","            images: [image]","        )","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Up to four images can be attached to a post. All images need to be a .jpg format."}]},{"anchor":"Videos","type":"heading","level":2,"text":"Videos"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar to images, you can add videos to a post."}]},{"type":"codeListing","code":["let videoURL = URL(string: \"\/path\/to\/file\/beach.mp4\")","","do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"The waves on the beach are looking as beautiful as ever.\",","        embed: .video(video: Data(contentsOf: videoFileURL))","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only one video can be added to a post, can be 100 MB or less, and must use the .mp4 format."},{"type":"text","text":" "},{"type":"text","text":"You can upload up to 25 videos per day and the 25 videos can’t exceed a total of 500 MB"},{"type":"text","text":" "},{"type":"text","text":"for the day."}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"Bluesky allows you to upload GIFs the same way, as it considers it to be a special kind","type":"text"},{"text":" ","type":"text"},{"text":"of video.. The only difference with a GIF is the lack a player scrubber. The same restrictions","type":"text"},{"text":" ","type":"text"},{"text":"with respect to videos apply to uploaded GIFs.","type":"text"}]}]},{"text":"External Links","level":2,"anchor":"External-Links","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can attach a website card to the post."}]},{"type":"codeListing","code":["Task {","    print(\"Starting application...\")","","    do {","        try await config.authenticate(with: \"example.bsky.social\", password: \"hunter2\")","","        let externalLinkBuilder = ExternalLinkBuilder()","","        guard let link = URL(string: \"https:\/\/www.youtube.com\/watch?v=dQw4w9WgXcQ\") else { return }","        let metadata = try await linkBuilder.grabMetadata(from: link)","","        let atProto = await ATProtoKit(sessionConfiguration: config)","        let atProtoBluesky = ATProtoBluesky(atProtoKitInstance: atProto)","","        let postResult = try await atProtoBluesky.createPostRecord(","            text: \"Really glad to hear his talk in person!\",","            embed: .external(","                url: metadata.url,","                title: metadata.title,","                description: metadata.description ?? \"No description given.\",","                thumbnailURL: metadata.thumbnailURL","            )","        )","","        print(\"Post Result: \\(postResult)\")","    } catch {","        throw error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If there are any links in the post’s text, the method will not convert it into a"},{"type":"text","text":" "},{"type":"text","text":"website card; you will need to manually achieve this."}]},{"anchor":"Creating-a-Quote-Post","type":"heading","level":1,"text":"Creating a Quote Post"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Quote posts are also embeds: you simply need to embed the record’s strong reference to it."}]},{"type":"codeListing","code":["do {","    let strongReference = ComAtprotoLexicon.Repository.StrongReference(recordURI: record.uri, cidHash: record.cid)","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Me whenever I look at my email:\",","        embed: .record(strongReference: strongReference)","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only one record can be embedded. This isn’t limited to post records, though: you can embed"},{"type":"text","text":" "},{"type":"text","text":"any Bluesky-related record that you wish."}]},{"anchor":"Creating-a-Reply","type":"heading","level":1,"text":"Creating a Reply"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create a reply, pass the reply reference of the post’s reply reference to the post record."}]},{"type":"codeListing","code":["do {","    let replyReference = try await ATProtoTools().createReplyReference(","        from: parentPost,","        session: session","    )","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"I also like pancakes.\",","        replyTo: replyReference","    )","","    print(postResult)","} catch {","    throw error","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to create a thread of posts, use"},{"type":"text","text":" "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoTools\/createReplyReference(from:session:)","type":"reference","isActive":true},{"type":"text","text":" to create the reply reference and"},{"type":"text","text":" "},{"type":"text","text":"pass that over to "},{"type":"codeVoice","code":"replyTo"},{"type":"text","text":":"}]},{"type":"codeListing","code":["do {","    let threadPost = try await atProtoBluesky.createPostRecord(","        text: \"I like waffles.\"","    )","","    print(\"Replying...\")","","    let firstReplyReference = try await ATProtoTools().createReplyReference(from: threadPost, session: session)","","    let threadPost2 = try await atProtoBluesky.createPostRecord(","        text: \"I also like pancakes.\",","        replyTo: firstReplyReference","    )","","    print(\"Second reply...\")","","    let secondReplyReference = try await ATProtoTools().createReplyReference(from: threadPost2, session: session)","","    let threadPost3 = try await atProtoBluesky.createPostRecord(","        text: \"I also like ice cream.\",","        replyTo: secondReplyReference","    )","} catch {","    throw error","}"],"syntax":"swift"},{"anchor":"Adding-Audience-Controls","type":"heading","level":1,"text":"Adding Audience Controls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can control who can reply to your post and whether it can be embedded by other posts."}]},{"anchor":"Controlling-Replies-Threadgate","type":"heading","level":2,"text":"Controlling Replies (Threadgate)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"replyControls"},{"type":"text","text":" parameter to restrict who can reply:"}]},{"type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Only my followers can reply to this post!\",","        r