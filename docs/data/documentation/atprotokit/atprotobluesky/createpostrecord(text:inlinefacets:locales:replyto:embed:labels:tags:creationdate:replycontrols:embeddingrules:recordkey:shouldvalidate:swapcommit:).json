{"kind":"symbol","abstract":[{"type":"text","text":"A convenience method to create a post record to the user account in Bluesky."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"createPostRecord"},{"kind":"text","text":"("},{"kind":"externalParam","text":"text"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"inlineFacets"},{"kind":"text","text":": [(url"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URL","preciseIdentifier":"s:10Foundation3URLV"},{"kind":"text","text":", startPosition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", endPosition"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")]? = nil, "},{"kind":"externalParam","text":"locales"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Locale","preciseIdentifier":"s:10Foundation6LocaleV"},{"kind":"text","text":"] = [], "},{"kind":"externalParam","text":"replyTo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon","text":"AppBskyLexicon","preciseIdentifier":"s:10ATProtoKit14AppBskyLexiconO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon\/Feed","text":"Feed","preciseIdentifier":"s:10ATProtoKit14AppBskyLexiconO4FeedO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon\/Feed\/PostRecord","text":"PostRecord","preciseIdentifier":"s:10ATProtoKit14AppBskyLexiconO4FeedO10PostRecordV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppBskyLexicon\/Feed\/PostRecord\/ReplyReference","text":"ReplyReference","preciseIdentifier":"s:10ATProtoKit14AppBskyLexiconO4FeedO10PostRecordV14ReplyReferenceV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"embed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","text":"ATProtoBluesky","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/EmbedIdentifier","text":"EmbedIdentifier","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC15EmbedIdentifierO"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"labels"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon","text":"ComAtprotoLexicon","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Label","text":"Label","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO5LabelO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Label\/SelfLabelsDefinition","text":"SelfLabelsDefinition","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO5LabelO20SelfLabelsDefinitionV"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"tags"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"creationDate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:10Foundation4DateV"},{"kind":"text","text":" = Date(), "},{"kind":"externalParam","text":"replyControls"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","text":"ATProtoBluesky","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/ThreadgateAllowRule","text":"ThreadgateAllowRule","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC19ThreadgateAllowRuleO"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"embeddingRules"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky","text":"ATProtoBluesky","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/PostgateEmbeddingRule","text":"PostgateEmbeddingRule","preciseIdentifier":"s:10ATProtoKit0A7BlueskyC21PostgateEmbeddingRuleO"},{"kind":"text","text":"]? = nil, "},{"kind":"externalParam","text":"recordKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"shouldValidate"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"? = true, "},{"kind":"externalParam","text":"swapCommit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon","text":"ComAtprotoLexicon","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository","text":"Repository","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO10RepositoryO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ComAtprotoLexicon\/Repository\/StrongReference","text":"StrongReference","preciseIdentifier":"s:10ATProtoKit17ComAtprotoLexiconO10RepositoryO15StrongReferenceV"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text that’s directly displayed in the post record. Current limit is"},{"type":"text","text":" "},{"type":"text","text":"300 characters."}]}],"name":"text"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of URLs and index range numbers representing inline link facets."},{"type":"text","text":" "},{"type":"text","text":"Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"inlineFacets"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The languages the text is written in. Defaults to an empty array."},{"type":"text","text":" "},{"type":"text","text":"Current limit is 3 languages."}]}],"name":"locales"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The post record that this record is replying to. Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"replyTo"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The embed container attached to the post record. Current items include"},{"type":"text","text":" "},{"type":"text","text":"images, videos, external links, records, and post records with media. Optional."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"embed"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of labels made by the user. Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"labels"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of tags for the post record. Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"tags"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The date of the post record. Defaults to "},{"type":"codeVoice","code":"Date.now"},{"type":"text","text":"."}]}],"name":"creationDate"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of rules to control who can reply to the post. Optional."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". When provided, a threadgate record is created for the post."}]}],"name":"replyControls"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An array of rules to control embedding of the post. Optional."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". When provided, a postgate record is created for the post."}]}],"name":"embeddingRules"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The record key of the collection. Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"recordKey"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Indicates whether the record should be validated. Optional."},{"type":"text","text":" "},{"type":"text","text":"Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}]}],"name":"shouldValidate"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swaps out an operation based on the CID. Optional. Defaults to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}],"name":"swapCommit"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A strong reference, which contains the newly-created record’s URI and CID hash."}]}],"kind":"content"},{"mentions":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATLinkBuilderProtocol","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/Getting-Started-with-ATProtoKit"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This can be used instead of creating your own method if you wish not to do so."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Postgate and threadgate records are currently created after the post. If postgate or"},{"type":"text","text":" "},{"type":"text","text":"threadgate creation fails, the post may already exist; the thrown error does not indicate that the post"},{"type":"text","text":" "},{"type":"text","text":"was rolled back."}]}],"style":"important","name":"Important"},{"type":"heading","level":1,"text":"Creating a Post","anchor":"Creating-a-Post"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After you authenticate into Bluesky, you can create a post by using the "},{"type":"codeVoice","code":"text"},{"type":"text","text":" argument:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Just tried out the new coffee shop in town ☕️ — highly recommend the cold brew!\"","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your post is longer than 300 characters, the method will only take the first 300"},{"type":"text","text":" "},{"type":"text","text":"characters, discarding the rest."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bluesky will automatically set the language of the post to English, but if you need to"},{"type":"text","text":" "},{"type":"text","text":"manually set it, you can use the "},{"type":"codeVoice","code":"locales"},{"type":"text","text":" argument:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Première promenade d'automne 🍂. Les couleurs sont magnifiques cette année!\",","        locales: [Locale(identifier: \"fr_FR\")]","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add up to three locales at once; only the first three items will be added as this"},{"type":"text","text":" "},{"type":"text","text":"is the limit mandated by Bluesky."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"createPostRecord()"},{"type":"text","text":" will automatically look for URLs, hashtags, and @mentions for you."},{"type":"text","text":" "},{"type":"text","text":"However, if you would like to add inline link facets to your account, you can use the"},{"type":"text","text":" "},{"type":"codeVoice","code":"inlineFacets"},{"type":"text","text":" parameter:"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let inlineFacet = (URL(string: \"https:\/\/www.loc.gov\/resource\/pga.05046\/\"), 57, 72)","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Where's that weird photo of a cat when you need one?\\n\\nAh: here it is!\",","        inlineFacets: [inlineFacet]","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"startPostion"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endPostion"},{"type":"text","text":" must be UTF-8 values."}]}],"style":"note","name":"Note"},{"type":"heading","level":1,"text":"Adding Embedded Content","anchor":"Adding-Embedded-Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can embed various kinds of content in your post, from media to external links,"},{"type":"text","text":" "},{"type":"text","text":"to other records."}]},{"type":"heading","level":2,"text":"Images","anchor":"Images"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoTools\/ImageQuery","type":"reference","isActive":true},{"type":"text","text":" to add details to the image, such as"},{"type":"text","text":" "},{"type":"text","text":"alt text, then attach it to the post record."}]},{"type":"codeListing","syntax":"swift","code":["do {","    let image = ATProtoTools.ImageQuery(","        imageData: Data(contentsOf: \"\/path\/to\/file\/cat.jpg\"),","        fileName: \"cat.jpg\",","        altText: \"A cat looking annoyed, wearing a hat.\"","    )","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"I don't think my cat likes her new hat... 🙃\",","        embed: .images(","            images: [image]","        )","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Up to four images can be attached to a post. All images need to be a .jpg format."}]},{"type":"heading","level":2,"text":"Videos","anchor":"Videos"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar to images, you can add videos to a post."}]},{"type":"codeListing","syntax":"swift","code":["let videoURL = URL(string: \"\/path\/to\/file\/beach.mp4\")","","do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"The waves on the beach are looking as beautiful as ever.\",","        embed: .video(video: Data(contentsOf: videoFileURL))","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only one video can be added to a post, can be 100 MB or less, and must use the .mp4 format."},{"type":"text","text":" "},{"type":"text","text":"You can upload up to 25 videos per day and the 25 videos can’t exceed a total of 500 MB"},{"type":"text","text":" "},{"type":"text","text":"for the day."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bluesky allows you to upload GIFs the same way, as it considers it to be a special kind"},{"type":"text","text":" "},{"type":"text","text":"of video.. The only difference with a GIF is the lack a player scrubber. The same restrictions"},{"type":"text","text":" "},{"type":"text","text":"with respect to videos apply to uploaded GIFs."}]}],"style":"tip","name":"Tip"},{"type":"heading","level":2,"text":"External Links","anchor":"External-Links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can attach a website card to the post."}]},{"type":"codeListing","syntax":"swift","code":["Task {","    print(\"Starting application...\")","","    do {","        try await config.authenticate(with: \"example.bsky.social\", password: \"hunter2\")","","        let externalLinkBuilder = ExternalLinkBuilder()","","        guard let link = URL(string: \"https:\/\/www.youtube.com\/watch?v=dQw4w9WgXcQ\") else { return }","        let metadata = try await linkBuilder.grabMetadata(from: link)","","        let atProto = await ATProtoKit(sessionConfiguration: config)","        let atProtoBluesky = ATProtoBluesky(atProtoKitInstance: atProto)","","        let postResult = try await atProtoBluesky.createPostRecord(","            text: \"Really glad to hear his talk in person!\",","            embed: .external(","                url: metadata.url,","                title: metadata.title,","                description: metadata.description ?? \"No description given.\",","                thumbnailURL: metadata.thumbnailURL","            )","        )","","        print(\"Post Result: \\(postResult)\")","    } catch {","        throw error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If there are any links in the post’s text, the method will not convert it into a"},{"type":"text","text":" "},{"type":"text","text":"website card; you will need to manually achieve this."}]},{"type":"heading","level":1,"text":"Creating a Quote Post","anchor":"Creating-a-Quote-Post"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Quote posts are also embeds: you simply need to embed the record’s strong reference to it."}]},{"type":"codeListing","syntax":"swift","code":["do {","    let strongReference = ComAtprotoLexicon.Repository.StrongReference(recordURI: record.uri, cidHash: record.cid)","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Me whenever I look at my email:\",","        embed: .record(strongReference: strongReference)","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only one record can be embedded. This isn’t limited to post records, though: you can embed"},{"type":"text","text":" "},{"type":"text","text":"any Bluesky-related record that you wish."}]},{"type":"heading","level":1,"text":"Creating a Reply","anchor":"Creating-a-Reply"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create a reply, pass the reply reference of the post’s reply reference to the post record."}]},{"type":"codeListing","syntax":"swift","code":["do {","    let replyReference = try await ATProtoTools().createReplyReference(","        from: parentPost,","        session: session","    )","","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"I also like pancakes.\",","        replyTo: replyReference","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to create a thread of posts, use"},{"type":"text","text":" "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoTools\/createReplyReference(from:session:)","type":"reference","isActive":true},{"type":"text","text":" to create the reply reference and"},{"type":"text","text":" "},{"type":"text","text":"pass that over to "},{"type":"codeVoice","code":"replyTo"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["do {","    let threadPost = try await atProtoBluesky.createPostRecord(","        text: \"I like waffles.\"","    )","","    print(\"Replying...\")","","    let firstReplyReference = try await ATProtoTools().createReplyReference(from: threadPost, session: session)","","    let threadPost2 = try await atProtoBluesky.createPostRecord(","        text: \"I also like pancakes.\",","        replyTo: firstReplyReference","    )","","    print(\"Second reply...\")","","    let secondReplyReference = try await ATProtoTools().createReplyReference(from: threadPost2, session: session)","","    let threadPost3 = try await atProtoBluesky.createPostRecord(","        text: \"I also like ice cream.\",","        replyTo: secondReplyReference","    )","} catch {","    throw error","}"]},{"type":"heading","level":1,"text":"Adding Audience Controls","anchor":"Adding-Audience-Controls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can control who can reply to your post and whether it can be embedded by other posts."}]},{"type":"heading","level":2,"text":"Controlling Replies (Threadgate)","anchor":"Controlling-Replies-Threadgate"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"replyControls","type":"codeVoice"},{"text":" parameter to restrict who can reply:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Only my followers can reply to this post!\",","        replyControls: [.allowFollowers]","    )","","    print(postResult)","} catch {","    throw error","}"]},{"inlineContent":[{"text":"You can combine multiple rules:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Only people I follow or who follow me can reply.\",","        replyControls: [.allowFollowers, .allowFollowing]","    )","","    print(postResult)","} catch {","    throw error","}"]},{"type":"heading","level":2,"text":"Disabling Embedding (Postgate)","anchor":"Disabling-Embedding-Postgate"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"embeddingRules","type":"codeVoice"},{"type":"text","text":" parameter to prevent others from quoting your post:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"This post cannot be quoted by others.\",","        embeddingRules: [.disable]","    )","","    print(postResult)","} catch {","    throw error","}"]},{"inlineContent":[{"text":"You can combine both audience controls:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["do {","    let postResult = try await atProtoBluesky.createPostRecord(","        text: \"Followers only replies, no quotes allowed.\",","        replyControls: [.allowFollowers],","        embeddingRules: [.disable]","    )","","    print(postResult)","} catch {","    throw error","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/atprotokit\/atprotobluesky\/createpostrecord(text:inlinefacets:locales:replyto:embed:labels:tags:creationdate:replycontrols:embeddingrules:recordkey:shouldvalidate:swapcommit:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoBluesky\/createPostRecord(text:inlineFacets:locales:replyTo:embed:labels:tags:creationDate:replyControls:embeddingRules:recordKey:shouldValidate:swapCommit:)","interfaceLanguage":"swift"},"metadata":{"extendedModule":"ATPro