{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CredentialStorageMigration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtocolConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKitConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfigurationArticle","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorization","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordAuthenticating","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATAccountCreating","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordCredentialStoring","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppPasswordSessionManaging","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthWalkthrough","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthSessionSynchronizing","doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ClosureATRequestExecutor"],"generated":true,"title":"Authentication and Session Management","anchor":"Authentication-and-Session-Management"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"ATProtoKit provides the XRPC client surface but does not implement the AT Protocol OAuth flow. Use an OAuth package to own identity resolution, server metadata discovery, pushed authorization requests (PAR), PKCE, DPoP keys and nonces, token persistence, refresh token rotation, and retries. Connect that package through ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The OAuth package must send authenticated requests itself. A DPoP proof is bound to the final HTTP method and URL, and a server can require a fresh nonce. For that reason, copying an access token or a precomputed ","type":"text"},{"code":"DPoP","type":"codeVoice"},{"text":" header into ATProtoKit is not sufficient.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Persist through a shared secure backend","anchor":"Persist-through-a-shared-secure-backend"},{"inlineContent":[{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATCredentialStore","isActive":true,"type":"reference"},{"type":"text","text":" can be the common secure value backend for App Password and OAuth persistence. It stores opaque data and deliberately knows nothing about OAuth models. App Password sessions use it directly for their password and refresh token, while their access token remains in-memory. OAuth sessions use it only when the application’s OAuth persistence adapter chooses to do so. On Apple platforms, "},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/AppleSecureKeychain","isActive":true,"type":"reference"},{"text":" is the included persistent implementation.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app can therefore pass one Keychain backend to its OAuth-specific persistence adapter:"}]},{"syntax":"swift","type":"codeListing","code":["let secureStore = AppleSecureKeychain(","    serviceName: \"com.example.app.credentials\"",")","","let oauthSessionStore = ExampleOAuthSessionStore(secureStore: secureStore)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The same backend can be used for an App Password account. Persist the account identifier outside the credential store and reuse it when recreating the configuration:"}]},{"syntax":"swift","type":"codeListing","code":["let appPasswordConfiguration = ATProtocolConfiguration(","    credentialStore: secureStore,","    sessionIdentifier: persistedAccountIdentifier",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The OAuth adapter must use its own stable keys, while "},{"type":"codeVoice","code":"ATProtocolConfiguration"},{"type":"text","text":" namespaces App Password values with "},{"type":"codeVoice","code":"sessionIdentifier"},{"type":"text","text":". Sharing the backend therefore does not combine their credential models or make OAuth persistence automatic."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The adapter remains responsible for encoding the OAuth package’s complete restorable session, including its tokens and DPoP key. ATProtoKit does not prescribe that model, import the OAuth package, or store only part of the session."}]},{"text":"Create the bridge","type":"heading","anchor":"Create-the-bridge","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adapt the OAuth package’s request operation with "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ClosureATRequestExecutor","isActive":true},{"type":"text","text":". The executor receives the completed request body and an "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATRequestAuthorizationRequirement","isActive":true},{"type":"text","text":" value that distinguishes public requests from requests requiring the active session."}]},{"code":["let publicSession = URLSession(configuration: .default)","let executor = ClosureATRequestExecutor { request, requirement in","    switch requirement {","    case .none:","        return try await publicSession.data(for: request)","    case .session:","        return try await oauthClient.sendAuthorizedRequest(request)","    }","}","","let configuration = ATOAuthSessionConfiguration(","    pdsURL: restoredSession.pdsURL.absoluteString,","    requestExecutor: executor,","    contextProvider: {","        return SessionAuthorizationContext(","            sessionDID: restoredSession.accountDID,","            handle: restoredSession.handle,","            serviceEndpoint: restoredSession.pdsURL,","            grantedScopes: restoredSession.grantedScopes","        )","    },","    refreshHandler: {","        let refreshedSession = try await oauthClient.refreshSession()","        return SessionAuthorizationContext(","            sessionDID: refreshedSession.accountDID,","            handle: refreshedSession.handle,","            serviceEndpoint: refreshedSession.pdsURL,","            grantedScopes: refreshedSession.grantedScopes","        )","    },","    deletionHandler: {","        try await oauthClient.deleteSession()","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The names on "},{"type":"codeVoice","code":"oauthClient"},{"type":"text","text":" and the restored session in this example are placeholders. Map them to the API of the OAuth package selected by the application. The "},{"type":"codeVoice","code":".none"},{"type":"text","text":" branch must remain unauthenticated. The "},{"type":"codeVoice","code":".session"},{"type":"text","text":" branch must let the OAuth package apply current tokens and DPoP proofs, handle nonce challenges, refresh when necessary, and retry the final request."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An OAuth configuration’s executor owns both authorization and transport. If an "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/APIClientConfiguration","isActive":true},{"type":"text","text":" passed to "},{"type":"codeVoice","code":"ATProtoKit"},{"type":"text","text":" also contains a response provider or request authenticator, ATProtoKit keeps the OAuth executor and does not replace or layer authorization over it."}]},{"text":"Use a fixed context","type":"heading","anchor":"Use-a-fixed-context","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the identity, Personal Data Server (PDS) endpoint, and granted scopes remain fixed for the lifetime of the configuration, pass an already-created "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext","isActive":true},{"type":"text","text":". This initializer derives the bootstrap PDS URL from the context and supplies the context provider internally."}]},{"code":["let context = SessionAuthorizationContext(","    sessionDID: authorizedSession.accountDID,","    handle: authorizedSession.handle,","    serviceEndpoint: authorizedSession.pdsURL,","    grantedScopes: authorizedSession.grantedScopes",")","","let configuration = ATOAuthSessionConfiguration(","    context: context,","    requestExecutor: executor,","    deletionHandler: {","        try await oauthClient.deleteSession()","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use the provider-based initializer instead when the visible identity, endpoint, or exact scope set can change while the configuration remains alive. Neither initializer depends on a particular OAuth package.","type":"text"}]},{"text":"Request additional scopes","type":"heading","anchor":"Request-additional-scopes","level":2},{"type":"paragraph","inlineContent":[{"text":"Scopes are requested by the external OAuth package before it creates the session, not by ","type":"text"},{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true,"type":"reference"},{"text":". The ","type":"text"},{"code":"scope","type":"codeVoice"},{"text":" field in the app’s published client metadata must declare every scope the client might request. Each authorization flow can request that complete set or a subset, but its request must always include ","type":"text"},{"code":"atproto","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"text","text":"For example, an OAuthenticator integration can pass additional permission strings when it creates"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppCredentials"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let requestedScopes = [","    \"atproto\",","    \"repo:app.bsky.feed.post\",","    \"blob:image\/*\"","]","","let credentials = AppCredentials(","    clientId: clientMetadataURL.absoluteString,","    clientPassword: \"\",","    scopes: requestedScopes,","    callbackURL: callbackURL",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The corresponding client metadata must contain at least those values as one space-separated string:"}],"type":"paragraph"},{"code":["{","  \"scope\": \"atproto repo:app.bsky.feed.post blob:image\/*\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"The exact OAuth package API in this example is not part of ATProtoKit. Use the selected package’s authorization configuration to supply the requested scopes. Prefer granular permissions and request only those needed by the enabled features."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Changing the requested set does not expand an already-authorized session. Start a new OAuth authorization flow with the expanded set and replace the stored session after the user approves it. A sample that automatically restores a saved login must bypass or replace that login during the upgrade; otherwise it can continue returning the old grants without presenting authorization."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"After the token exchange, build "},{"type":"codeVoice","code":"grantedScopes"},{"type":"text","text":" from the token response’s complete returned "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" value. Do not copy "},{"type":"codeVoice","code":"requestedScopes"},{"type":"text","text":" into the context because a user or server may grant a smaller set:"}],"type":"paragraph"},{"code":["let grantedScopes = Set(","    authorizedSession.scope","        .split(separator: \" \")","        .map(String.init)",")","","let context = SessionAuthorizationContext(","    sessionDID: authorizedSession.accountDID,","    handle: authorizedSession.handle,","    serviceEndpoint: authorizedSession.pdsURL,","    grantedScopes: grantedScopes",")"],"type":"codeListing","syntax":"swift"},{"text":"Register a restored or newly authorized session","type":"heading","level":2,"anchor":"Register-a-restored-or-newly-authorized-session"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration\/registerSession()","isActive":true},{"type":"text","text":" after authorization or restoration and before using authenticated ATProtoKit methods. Registration validates and publishes the account decentralized identifier (DID) and provider-supplied PDS endpoint. "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATProtoKit\/createOAuthSession(sessionConfiguration:apiClientConfiguration:canUseBlueskyRecords:)","isActive":true},{"type":"text","text":" performs registration and client construction as one checked operation:"}],"type":"paragraph"},{"code":["let client = try await ATProtoKit.createOAuthSession(","    sessionConfiguration: configuration",")","let timeline = try await client.getTimeline()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The equivalent explicit sequence remains available when an application needs to perform work between registration and client construction:"}],"type":"paragraph"},{"code":["try await configuration.registerSession()","let registeredContext = try await configuration.authorizationContext()","let registeredPDSURL = registeredContext?.serviceEndpoint.absoluteString","    ?? configuration.pdsURL","let client = await ATProtoKit(","    sessionConfiguration: configuration,","    pdsURL: registeredPDSURL",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use the registered context’s endpoint when constructing the client manually. The "},{"type":"codeVoice","code":"pdsURL"},{"type":"text","text":" passed to the provider-based initializer is only the bootstrap value used before a context is loaded; it does not change when a different context is registered."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Registration and explicit synchronization validate the supplied context. A valid context must contain:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a syntactically valid DID;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"an HTTPS PDS origin without credentials, a path prefix, a query, or a fragment;"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the mandatory "},{"type":"codeVoice","code":"atproto"},{"type":"text","text":" scope."}]}]}]},{"inlineContent":[{"type":"text","text":"Invalid contexts throw "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfigurationError","isActive":true},{"type":"text","text":" and are not placed in "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistry","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Check granted permissions","type":"heading","level":2,"anchor":"Check-granted-permissions"},{"inlineContent":[{"type":"text","text":"The token response’s complete "},{"type":"codeVoice","code":"scope"},{"type":"text","text":" value should be passed to "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext\/init(sessionDID:handle:serviceEndpoint:grantedScopes:)","isActive":true},{"type":"text","text":". Before presenting or starting a feature, the application can check its required scopes:"}],"type":"paragraph"},{"code":["guard let context = try await configuration.authorizationContext() else {","    return \/\/ Treat the absent context as a signed-out session.","}","try context.requireGrantedScopes([","    \"repo:app.bsky.feed.post\",","    \"blob:image\/*\"","])"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext\/hasGrantedScope(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext\/missingGrantedScopes(from:)","isActive":true},{"type":"text","text":" use exact string comparison. They do not expand permission wildcards or permission-set references. This preserves the authorization server’s interpretation and avoids claiming a permission the server did not explicitly return."}],"type":"paragraph"},{"text":"Present authorization","type":"heading","level":2,"anchor":"Present-authorization"},{"inlineContent":[{"type":"text","text":"The OAuth package is responsible for presenting its authorization URL and receiving the redirect. ATProtoKit doesn’t import platform authentication frameworks or provide a browser presentation abstraction. This keeps presentation, callback routing, and the protocol state that protects the flow under one owner."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The OAuth package must validate the callback’s "},{"type":"codeVoice","code":"state"},{"type":"text","text":" and "},{"type":"codeVoice","code":"iss"},{"type":"text","text":" values, exchange the authorization code, check the token response’s "},{"type":"codeVoice","code":"sub"},{"type":"text","text":" and "},{"type":"codeVoice","code":"scope"},{"type":"text","text":", and persist the resulting session. After that work completes, pass the session context and OAuth-aware request executor to "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Refresh and deletion","type":"heading","level":2,"anchor":"Refresh-and-deletion"},{"inlineContent":[{"type":"text","text":"Normal authenticated requests should allow the OAuth executor to refresh and retry as required by the server. That request-time work does not automatically update the identity and PDS context cached by ATProtoKit. Call "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration\/synchronizeSession()","isActive":true},{"type":"text","text":" when the externally owned session context may have changed. When a "},{"type":"codeVoice","code":"refreshHandler"},{"type":"text","text":" is supplied, synchronization uses the context returned by that handler. Without one, synchronization reloads the context from "},{"type":"codeVoice","code":"contextProvider"},{"type":"text","text":". In either case, ATProtoKit validates and registers the returned context."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration\/removeSession()","isActive":true},{"type":"text","text":" invokes the configured deletion operation and then clears the cached context and local ATProtoKit registry entry. If the deletion operation throws, the local context and registry entry remain intact. The OAuth package decides whether deletion only removes local credentials or also revokes tokens at the authorization server."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"For protocol requirements, see the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/atproto.com\/specs\/oauth"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/atproto.com\/specs\/permission"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"}]}],"identifier":{"url":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthIntegration","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Connect an OAuth implementation to ATProtoKit without giving up DPoP-aware request handling."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/atprotokit\/oauthintegration"]}],"kind":"article","metadata":{"title":"Integrating OAuth in the AT Protocol","modules":[{"name":"ATProtoKit"}],"color":{"standardColorIdentifier":"blue"},"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/ATProtoKit\/documentation\/ATProtoKit"]]},"references":{"doc://ATProtoKit/documentation/ATProtoKit/ATOAuthSessionConfigurationError":{"url":"\/documentation\/atprotokit\/atoauthsessionconfigurationerror","abstract":[{"type":"text","text":"An error type related to "},{"type":"reference","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfiguration","isActive":true}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ATOAuthSessionConfigurationError","kind":"identifier"}],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATOAuthSessionConfigurationError","role":"symbol","kind":"symbol","title":"ATOAuthSessionConfigurationError","navigatorTitle":[{"text":"ATOAuthSessionConfigurationError","kind":"identifier"}],"type":"topic"},"doc://ATProtoKit/documentation/ATProtoKit/SessionAuthorizationContext":{"title":"SessionAuthorizationContext","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SessionAuthorizationContext"}],"url":"\/documentation\/atprotokit\/sessionauthorizationcontext","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionAuthorizationContext","abstract":[{"type":"text","text":"Describes the AT Protocol identity and service endpoint made visible to ATProtoKit."}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SessionAuthorizationContext"}]},"doc://ATProtoKit/documentation/ATProtoKit":{"kind":"symbol","title":"ATProtoKit","images":[{"type":"icon","identifier":"atprotokit_icon.png"}],"url":"\/documentation\/atprotokit","role":"collection","type":"topic","abstract":[{"type":"text","text":"Develop and manage client and server-side applications for the AT Protocol and Bluesky."}],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit"},"doc://ATProtoKit/documentation/ATProtoKit/APIClientConfiguration":{"abstract":[{"text":"A configuration container for customizing the behavior of an API client.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/APIClientConfiguration","navigatorTitle":[{"text":"APIClientConfiguration","kind":"identifier"}],"type":"topic","title":"APIClientConfiguration","url":"\/documentation\/atprotokit\/apiclientconfiguration","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"APIClientConfiguration","kind":"identifier"}]},"doc://ATProtoKit/documentation/ATProtoKit/CredentialStorageMigration":{"url":"\/documentation\/atprotokit\/credentialstoragemigration","abstract":[{"type":"text","text":"Migrate App Password credential handling from "},{"type":"codeVoice","code":"SecureKeychainProtocol"},{"type":"text","text":" in version 0.33.3 to"},{"type":"text","text":" "},{"type":"codeVoice","code":"ATCredentialStore"},{"type":"text","text":" in ATProtoKit 0.34.0."}],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/CredentialStorageMigration","role":"article","kind":"article","title":"Migrating Credential Storage","type":"topic"},"doc://ATProtoKit/documentation/ATProtoKit/ATAccountCreating":{"role":"symbol","title":"ATAccountCreating","abstract":[{"text":"Creates AT Protocol accounts through a session configuration.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"ATAccountCreating"}],"url":"\/documentation\/atprotokit\/ataccountcreating","type":"topic","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/ATAccountCreating","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ATAccountCreating"}],"kind":"symbol"},"doc://ATProtoKit/documentation/ATProtoKit/SessionConfigurationArticle":{"url":"\/documentation\/atprotokit\/sessionconfigurationarticle","abstract":[{"type":"text","text":"Choose a built-in authentication configuration or implement ATProtoKit’s request-time session contract."}],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfigurationArticle","role":"article","kind":"article","title":"Configuring and Implementing Sessions","type":"topic"},"doc://ATProtoKit/documentation/ATProtoKit/SessionConfiguration":{"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/SessionConfiguration","abstract":[{"text":"Defines the request-time requirements shared by all ATProtoKit session configurations.","type":"text"}],"url":"\/documentation\/atprotokit\/sessionconfiguration","title":"SessionConfiguration","type":"topic","navigatorTitle":[{"text":"SessionConfiguration","kind":"identifier"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"SessionConfiguration","kind":"identifier"}]},"doc://ATProtoKit/documentation/ATProtoKit/OAuthSessionSynchronizing":{"url":"\/documentation\/atprotokit\/oauthsessionsynchronizing","abstract":[{"text":"Synchronizes session context owned by an external AT Protocol OAuth implementation.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuthSessionSynchronizing"}],"identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/OAuthSessionSynchronizing","role":"symbol","kind":"symbol","title":"OAuthSessionSynchronizing","navigatorTitle":[{"text":"OAuthSessionSynchronizing","kind":"identifier"}],"type":"topic"},"doc://ATProtoKit/documentation/ATProtoKit/UserSessionRegistry":{"kind":"symbol","identifier":"doc:\/\/ATProtoKit\/documentation\/ATProtoKit\/UserSessionRegistry","url":"\/documentation\/atprotokit\/usersessionregistry","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"UserSessionRegistry"}],"abstract":[{"type":"text","text":"A registry that manages "},{"type":"codeVoice","code":"UserSession"},{"type":"text","text":" instances, keyed by "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"."}],"role":"symbol","title":"UserSessionRegistry","navigatorTitle":[{"kind":"identifier","text":"UserSessionRegistry"}]},"doc://ATProtoKit/documentation/ATProtoKit/ATProtoKit/createOAuthSession(sessionConfiguration:apiClientConfiguration:canUseBlueskyRecords:)":{"url":"\/documentation\/atprotokit\/atprotokit\/createoauthsession(sessionconfiguration:apiclientconfiguration:canuseblueskyrecords:)","abstract":[{"text":"Creates an authenticated ATProtoKit client after registering an external OAuth session.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"createOAuthSession"},{"kind":"text","text":"("},{"kind":"externalParam","text":"sessionConfiguration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10ATProtoKit27ATOAuthSessionConfigurationC","kind":"typeIdentifier","text":"ATOAuthSessionConfiguration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"apiClientConfiguration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10ATProtoKit22APIClientConfigurationV","kind":"typeIdentifier","text":"APIClientConfiguration"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"canUseBlueskyRecords"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"